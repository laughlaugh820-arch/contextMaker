  "similes": [
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.867,
      "text": "それをお母さん、ちゃんと察して、私に用事を言いつけて、私に大手をふって映画見にゆけるように、しむけて下さった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.549,
      "text": "やっぱり、お父さんがいないと、家の中に、どこか大きい空席が、ポカンと残って在るような気がして、身悶えしたくなる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.785,
      "text": "日本の道徳に、とてもとても、こだわっているので、かえって反撥して、へんにどぎつくなっている作品が多かったような気がする。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.423,
      "text": "こんな所へ来て、こっそり髪をつくってもらうなんて、すごく汚らしい一羽の雌鶏みたいな気さえして来て、つくづくいまは後悔した。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.458,
      "text": "うんと重い病気になって、汗を滝のように流して細く痩せたら、私も、すっきり清浄になれるかも知れない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.063,
      "text": "どうも朝は、過ぎ去ったこと、もうせんの人たちの事が、いやに身近に、おタクワンの臭いのように味気なく思い出されて、かなわない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.136,
      "text": "五月のキウリの青味には、胸がカラッポになるような、うずくような、くすぐったいような悲しさが在る。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.623,
      "text": "気がつくと、私はぼんやりお鍋に両手をつっこんだままで、ばかみたいに、あれこれ考えていたのである。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.029,
      "text": "ひとの下品な歩き恰好を顰蹙していながら、ふと、自分も、そんな歩きかたしているのに気がついた時みたいに、すごく、しょげちゃった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.077,
      "text": "縁側に腰かけて、ジャピイの頭を撫でてやりながら、目に浸みる青葉を見ていると、情なくなって、土の上に坐りたいような気持になった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.127,
      "text": "盗み猫のように、音も立てずに生きて行く予感なんて、ろくなことはないと、むしろ、おそろしかった。"
    },
    {
      "markers": [
        "似る"
      ],
      "position": 0.893,
      "text": "ちゃんと知っていながら、一ことだって、それに似た名詞ひとつ形容詞ひとつ言い出せないじゃないか。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.038,
      "text": "それに、眼鏡をはずしている時は、決して人と喧嘩をしようなんて思わないし、悪口も言いたくない。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.754,
      "text": "軍隊生活しなくても、新ちゃんみたいに、素直な人だってあるのに、私は、よくよく、いけない女だ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.15,
      "text": "きっと、いまの戦争が終ったころ、こんな、夢を持ったような古風のアンブレラが流行するだろう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.242,
      "text": "けれどもここに書かれてある言葉全部が、なんだか、楽観的な、この人たちの普段の気持とは離れて、ただ書いてみたというような感じがする。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.664,
      "text": "つまらないことにでも、顔を畳にくっつけるようにして、からだをくねらせて、笑いむせぶのだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.932,
      "text": "昼間じゃぶじゃぶやって時間をつぶすの、惜しいような気がするのだけれど、反対かも知れない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.049,
      "text": "鼻が無くても、口が隠されていても、目が、その目を見ていると、もっと自分が美しく生きなければと思わせるような目であれば、いいと思っている。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.129,
      "text": "あんな気持の状態が、永くつづくと、人は、神がかりみたいになっちゃうのではないかしら。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.337,
      "text": "否定も肯定もない、ただ、大きな大きなものが、がばと頭からかぶさって来たようなものだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.87,
      "text": "お母さんと、こうして夜ふたりきりで暮すのも、ずいぶん久しぶりだったような気がする。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.056,
      "text": "青い湖のような目、青い草原に寝て大空を見ているような目、ときどき雲が流れて写る。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.178,
      "text": "その労働者たちは、いつもの例で、言えないような厭な言葉を私に向かって吐きかける。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.7,
      "text": "何も、お高くとまっているのではないけれども、あんな人たちとこれ以上、無理に話を合せてみたり、一緒に笑ってみたりする必要もないように思われる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.97,
      "text": "心の底まで透明になってしまって、崇高なニヒル、とでもいったような工合いになった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.208,
      "text": "けれども、そのような失敗にさえ、なんとか理窟をこじつけて、上手につくろい、ちゃんとしたような理論を編み出し、苦肉の芝居なんか得々とやりそうだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.142,
      "text": "一字一句、最大の効果を収めようと、うんうん唸って、絞り出したような名文だ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.172,
      "text": "しばらく経ってそこを通ってみると、麦が、きょうのように、すくすくしていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.223,
      "text": "読んでいるうちに、自分のことを言われたような気がして恥ずかしい気にもなる。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.658,
      "text": "今井田さんは、もう四十ちかいのに、好男子みたいに色が白くて、いやらしい。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.927,
      "text": "うちのお母さんも、エンリコのお母さんのように立派な美しいお母さんである。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.072,
      "text": "カアは、野良犬みたいに見えるから、いつ犬殺しにやられるか、わからない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.19,
      "text": "こんなくだらない事に平然となれるように、早く強く、清く、なりたかった。"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.895,
      "text": "ただ、どぎまぎして、おしまいには、かっとなって、まるでなにかみたいだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.803,
      "text": "これからさき、生きてゆく理由が無いような気がして来て、くるしくなる。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.285,
      "text": "悪い、不良みたいだ、と言って、お母さんは悲しがっていたようだった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.421,
      "text": "できあがったのを見ると、頼んだようにできていないので、がっかりだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.29,
      "text": "洋服いちまい作るのにも、人々の思惑を考えるようになってしまった。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.436,
      "text": "キン子さんは、全く無性格みたいで、それゆえ、女らしさで一ぱいだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.446,
      "text": "それに男か女か、わからないような、むっとした赤黒い顔をしている。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.218,
      "text": "これまでの私の自己批判なんて、まるで意味ないものだったと思う。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.244,
      "text": "「本当の意味の」とか、「本来の」とかいう形容詞がたくさんあるけれど、「本当の」愛、「本当の」自覚、とは、どんなものか、はっきり手にとるようには書かれていない。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.291,
      "text": "自分の個性みたいなものを、本当は、こっそり愛しているのだけれども、愛して行きたいとは思うのだけど、それをはっきり自分のものとして体現するのは、おっかないのだ。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.89,
      "text": "それに、このごろの私は、子供みたいに、きれいなところさえ無い。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.796,
      "text": "なお、黙っていると、小さい時の白さと違うように思われて来る。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.824,
      "text": "ひとりきりの秘密を、たくさんたくさん持つようになりました。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.949,
      "text": "ほって置くよりしようのない、ハシカみたいな病気なのかしら。"
    },
    {
      "markers": [
        "ようだ",
        "みたい"
      ],
      "position": 0.035,
      "text": "全体がかすんで、夢のように、覗き絵みたいに、すばらしい。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.46,
      "text": "しっかりした宗教の意味もわかりかけて来たような気がする。"
    },
    {
      "markers": [
        "ようだ",
        "みたい"
      ],
      "position": 0.992,
      "text": "鮒か、うなぎか、ぐいぐい釣糸をひっぱるように、なんだか重い、鉛みたいな力が、糸でもって私の頭を、ぐっとひいて、私がとろとろ眠りかけると、また、ちょっと糸をゆるめる。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.026,
      "text": "よいしょ、なんて、お婆さんの掛声みたいで、いやらしい。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.536,
      "text": "もう二週間もしたら、たべられるようになるかも知れない。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.725,
      "text": "焦ら焦らして、ヒステリイになったみたいに落ちつかない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.784,
      "text": "この作者は、とっても責任感の強いひとのような気がする。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.851,
      "text": "この扇子から、去年の夏が、ふうと煙みたいに立ちのぼる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.418,
      "text": "それから、ふっと、お母さん長生きするように、と思う。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.427,
      "text": "「このまま、見合いに行こうかしら」なぞと乱暴なこと言い出して、そのうちに、なんだかお寺さんご自身、見合いに、ほんとうに行くことにきまってしまったような錯覚を起したらしく、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.723,
      "text": "朝から晩まで、くるくるコマ鼠のように働いてあげる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.885,
      "text": "これからは、お母さんと二人だけの生活に満足し、いつもお母さんの気持になってあげて、昔の話をしたり、お父さんの話をしたり、一日でもよい、お母さん中心の日を作れるようにしたい。"
    }
  ],
