  "similes": [
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.08,
      "text": "「ああ眠ろう」喜兵衛は云った、「私は眠るから、おまえもつまらない心配はしないでおくれ、――みんなが来たようだね」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.261,
      "text": "家並の軒下はみるみる暗さが濃くなり、足早にゆき交う人たちをせきたてるかのように、夕餉の煮炊きの匂いが漂って来た。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.38,
      "text": "角ばった顔に、毒どくしい侮蔑と嫌悪の表情をうかべ、とびだしたようにみえるその眼は、嫉妬と嘲笑とで光っていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.694,
      "text": "聞いている六人は明らかに興ざめたようすで、酌をしたり肴を取り分けたりする手つきも、うわのそらのようにみえた。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.929,
      "text": "「もうちょっと」と彼は息を喘ませながら云った、「そのままもうちょっと、――ああ、まるでなにかの花のようだね」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.187,
      "text": "「いや、いや」おそのは激しく、子供のようにかぶりを振った、「あたし死人の側なんかはいや、きびがわるいから堪忍して」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.247,
      "text": "「それが本当なら」と男が云った、「どうしていつまでこんなふうに、蛇のなま殺しのようなめにあわせるんですか」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.276,
      "text": "顔は蒼黒く、筋がたるんで、唇の端から涎が垂れるのを、ときどき思いだしたように、右手の甲で横撫でにしていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.66,
      "text": "喉のところに拳くらいもある固まりのような物がこみあげてきて、息が止まり、眼の前がすうっと暗くなるような感じだった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.001,
      "text": "紫若はそこへ家を建てるので、追立てられた彼ははらだちまぎれに、その住み古した家の壁へ左のような狂歌を書いて立退いた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.211,
      "text": "これまでついぞみせたことのない、執念のようなあのときのようすは、それを「知っていた」ということを明らかに示すものだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.237,
      "text": "そのときは半刻ほどで帰ったが、帰るときの彼は、泣いたあとのように、眼を赤く腫らしてい、睫毛も濡れていた。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.275,
      "text": "肝を抜かれて放心したような蝶太夫は、ぼんやりと、まるで他人の家へでも来たように、戸口のところで立停った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.315,
      "text": "少年のころ恋人から文を貰ったときのように、みぞおちのところが熱くなり、足が地面から浮くような気持だった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.617,
      "text": "こっちも田舎ふうの造りらしいが、二人のはいった部屋は納戸のような六帖で、床の間と違い棚はあるが窓はない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.871,
      "text": "「へ、へ」佐吉は卑しく狡猾に笑った、「その手はくわねえ、飴を砂糖で煮つめたような、そんな甘い手に乗るおれじゃあねえ」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.102,
      "text": "それを持っていって、眺めよいように置くと、喜兵衛は黙って、かなりながいあいだ、うっとりとしたような眼で見まもっていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.256,
      "text": "にがみばしった顔が、にわかに浅薄な卑しさをあらわし、その眼はさらにけもののような貪欲な光を帯びてきた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.355,
      "text": "だが、やがてまた思いだしたように、「五十両」の話をどうして知っているのか、と不審そうにおりうに訊いた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.633,
      "text": "娘は「どうぞ」と云い、すぐ気がついたように、片方の膳の前にある座蒲団を取って、千之助のほうへすすめた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.669,
      "text": "骨ばかりのように病み衰えた父の顔に、頬笑みがうかび、枕の上でそっと頷くのが、ふしぎなくらいありありとみえるように思う。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.725,
      "text": "躯が弱くて保養でもしているのか、小間使と二人ぐらしで、訪ねて来る客もなし、まして浮いたような噂もない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.741,
      "text": "「いや」と千之助はあいまいに云った、「べつの事でひょっと思いついたんだが、どうやら見当が違ったようだ」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.895,
      "text": "女中が茶を替えに来たとき、おしのは窓框に肱を掛け、その上に顔を伏せたまま、眠ったような恰好をしていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.522,
      "text": "「まあ、――」女中は初めて気づいたように、彼の顔を見て眼をみはった、「まあひどい、どうなさいました」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.756,
      "text": "黄色みを帯びた蝋のような肌へ、深く、まっすぐに突き刺さっている銀の釵が、怨念と呪いの声をあげているように思えたのである。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.925,
      "text": "酔って力のぬけたような、やわらかにぐったりとした娘の躯は、源次郎の欲望をかきたて血を狂わせたようだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.011,
      "text": "今年はまだ正月にも帰っていない、というのは、主婦のおそのが連日のように客をするため、暇をもらうことができなかったのである。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.141,
      "text": "――五日の夜になると、参得の診断を証明するかのように、喜兵衛が「おそのを呼んでくれ」と云いだした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.617,
      "text": "一方の壁には、坐っていて眼の高さに小さな窓のような枠があり、縦三寸横一尺ほどの滑り戸が付いていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.061,
      "text": "しかし母に面倒をみてもらったようなことは少なくとも自分の記憶には残っていない、とおしのは思った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.569,
      "text": "「こういう人間は毒にも薬にもならないというが、おそのさんのような人にとっては毒になるばかりです」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.07,
      "text": "おしのはその父の性分を盾に取り、番頭たちの反対を押し切って、いつものように祝儀の支度をさせた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.276,
      "text": "蝶太夫はかしこまって、両手を膝へ突張り、うなだれた頭をぐらぐらと、張子の虎のように振っている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.378,
      "text": "娘のように赤く、ふっくらと湿っている唇が歪み、はっきりとした紛れのない双眸に、貪婪な、ぎらぎらするような膏ぎった色がうかんだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.193,
      "text": "「ちゃんと約束したのにお父つぁんが危篤だっていうのに、おっ母さんはあんな子供のような人を伴れて、箱根へ遊びにいったんじゃないの」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.225,
      "text": "――彼はまもなく出て来たが、その顔は怯えたように硬ばって、細くなり、眼は焦点をなくしていた。"
    },
    {
      "markers": [
        "ようだ",
        "ごとし"
      ],
      "position": 0.756,
      "text": "そこには血を落したかのように、椿の赤い花片が一枚、なにかを暗示するものの如く置かれてあった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.893,
      "text": "幸福でたのしそうで、いかにも満ち足りたようにみえていても、裏へまわると不幸で、貧しくて、泣くにも泣けないようなおもいをしている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.374,
      "text": "髪の毛が少ないので髷も小さく、血のけのない乾いた皮膚や、平たい胸や、肉のそげたような腰など、ぜんたいが干からびて縮んだようにみえる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.505,
      "text": "やがて門七が来、頭から雨合羽のような物をかぶって、ようやく彼は立ちあがり、誰にともなく礼を述べると、門七の手に支えられて歩きだした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.662,
      "text": "乳房が重く張り、固くなった乳首が肌着でこすれ、両腿の奥が湯でもこぼしたように熱くなる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.047,
      "text": "年は三十五歳、大柄ではあるが躯の線が美しく、胸や腰などは娘のようにすんなりしている。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.37,
      "text": "その真紅の一片の花びらは、まるでなにかを暗示するように、ぶきみな印象を人々に与えた。"
    },
    {
      "markers": [
        "似る"
      ],
      "position": 0.381,
      "text": "だがそれは怒りのためではなく、ぬかるみへ坐りこむ酔漢の、居直るような表情に似ていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.961,
      "text": "源次郎は恐怖そのものといった眼で、銀の釵と、山椿の血のように赤い花片をみつめていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.981,
      "text": "告白の文章はここで跡切れ、あとは墨の色も新らしく、走り書きで、次のように続いていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.683,
      "text": "清一は飲んだ酒が喉につかえでもしたように、ぐっといいながら、ちょっと口をつぐんだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.76,
      "text": "「あと二人、――」と彼は独り言のように呟いた、「それを止める法はないか、……いったいこの男たちはなにをしたのだ、椿の花片はどういう意味だ」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.258,
      "text": "日が昏れかかって、街には灯がつきはじめているが、空は磨いだように青ずんで高く、大川のほうから吹いて来る微風は、肌にしみとおるほど冷たかった。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.438,
      "text": "しかも、まるで相談でもしたように、二人の態度が同じ日に変った、というのはふしぎではないか、彼はそう思い、それから片手で額をとんとんと叩いた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.987,
      "text": "町方与力と聞いて、女中はちょっと驚いたようだったが、青木という名を告げられていたのだろう、「お待ちかねでございます」と云って、案内に立った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.184,
      "text": "眼が裂けるかと思うほど大きくみひらかれ、下顎がさがって空洞のように口があいた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.185,
      "text": "「死んでるって」とおそのは舌が痺れたような口ぶりで呟いた、「――死んでいるの」"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.217,
      "text": "抱きあって眠っている二人の姿は、見るに耐えないものであったが、おしのはまるで罪と汚辱を慥かめるかのように、やや暫くかれらの姿を見まもっていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.6,
      "text": "「よけいなことじゃありません、ここが肝心なところなんです」おはなはむっとしたようにやり返した、「それとも妹が着替えをしちゃあいけないんですか」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.715,
      "text": "「あの人はさんざんあくどいことをしましたからね」と菊弥が云った、「もしかするとその娘というのは人間じゃあなく、怨霊のようなものかもしれないわ」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.74,
      "text": "「油のためだったと思う、現場はひどく油臭かったし、納戸に燈油がだいぶしまってあったようだ、しょうばいは薬種問屋だが、油屋も兼業していたからね」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.881,
      "text": "その話をしたとき、源次郎は、そう云って軽蔑したように顔をしかめてみせたものだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.141,
      "text": "おちついたようにみえるのは躰力が尽きたからで、もう時間の問題であると告げた。"
    }
