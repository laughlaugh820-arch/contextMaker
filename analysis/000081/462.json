  "similes": [
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.021,
      "text": "と高く叫ぶ声がして、それからまるで大きなからすのように、嘉助がかばんをかかえてわらって運動場へかけて来ました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.784,
      "text": "ほんとうに暑くなって、ねむの木もまるで夏のようにぐったり見えましたし、空もまるで底なしの淵のようになりました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.069,
      "text": "みんなもまるでせっかく友だちになった子うまが遠くへやられたよう、せっかく捕った山雀に逃げられたように思いました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.6,
      "text": "たばこの木はもう下のほうの葉をつんであるので、その青い茎が林のようにきれいにならんでいかにもおもしろそうでした。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.755,
      "text": "庄助はまるで落ちついて、立って一あし水にはいるとすぐその持ったものを、さいかちの木の下のところへ投げこみました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.767,
      "text": "そのうしろからはちょうど活動写真のように、一人の網シャツを着た人が、はだか馬に乗ってまっしぐらに走って来ました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.926,
      "text": "三郎は気味悪そうに川のほうを見ていましたが、色のあせたくちびるを、いつものようにきっとかんで、「なんだい。」"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.962,
      "text": "それから金だらいを出して顔をぶるぶる洗うと、戸棚から冷たいごはんと味噌をだして、まるで夢中でざくざく食べました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.06,
      "text": "みんなそっちへ振り向きますと、五郎が耕助に足のゆびをふまれて、まるでおこって耕助をなぐりつけていたのです。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.838,
      "text": "みんなは町の祭りのときのガスのようなにおいの、むっとするねむの河原を急いで抜けて、いつものさいかち淵に着きました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.942,
      "text": "家の前の栗の木の列は変に青く白く見えて、それがまるで風と雨とで今洗濯をするとでもいうように激しくもまれていました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.491,
      "text": "すすきがざわざわざわっと鳴り、向こうのほうは底知れずの谷のように、霧の中に消えているではありませんか。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.116,
      "text": "まもなくみんなははきものを下駄箱に入れて教室へはいって、ちょうど外へならんだときのように組ごとに一列に机にすわりました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.575,
      "text": "その太陽は、少し西のほうに寄ってかかり、幾片かの蝋のような霧が、逃げおくれてしかたなしに光りました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.248,
      "text": "三郎は少し困ったように両手をうしろへ組むと向こう側の土手のほうへ職員室の前を通って歩きだしました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.642,
      "text": "もう耕助はじぶんでも持てないくらいあちこちへためていて、口も紫いろになってまるで大きく見えました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.667,
      "text": "耕助は試験のようだし、つまらないことになったと思ってたいへんくやしかったのですが、しかたなくしばらく考えてから言いました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.734,
      "text": "みんなはわれ勝ちに岸からまっさかさまに水にとび込んで、青白いらっこのような形をして底へもぐって、その石をとろうとしました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.706,
      "text": "ひるすぎは先生もたびたび教壇で汗をふき、四年生の習字も五年生六年生の図画もまるでむし暑くて、書きながらうとうとするのでした。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.947,
      "text": "遠くのほうの林はまるで海が荒れているように、ごとんごとんと鳴ったりざっと聞こえたりするのでした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.275,
      "text": "と言いながら鉛筆をふところの中へ入れて、あとはシナ人がおじぎするときのように両手を袖へ入れて、机へぴったり胸をくっつけました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.448,
      "text": "嘉助と三郎がもう一匹を押えようとそばへ寄りますと、馬はまるでおどろいたようにどてへ沿って一目散に南のほうへ走ってしまいました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.483,
      "text": "黒板から降る白墨の粉のような、暗い冷たい霧の粒が、そこら一面踊りまわり、あたりがにわかにシインとして、陰気に陰気になりました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.578,
      "text": "はるかな西の碧い野原は、今泣きやんだようにまぶしく笑い、向こうの栗の木は青い後光を放ちました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.066,
      "text": "と一郎が言いながらまた教室のほうを見ましたら、一郎はにわかにまるでぽかんとしてしまいました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.84,
      "text": "すっかり夏のような立派な雲の峰が東でむくむく盛りあがり、さいかちの木は青く光って見えました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.921,
      "text": "三郎はまるであわてて、何かに足をひっぱられるようにして淵からとびあがって、一目散にみんなのところに走って来て、がたがたふるえながら、"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.292,
      "text": "そしてまるでなんと言ったらいいかわからない、変な気持ちがして歯をきりきり言わせました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.975,
      "text": "昇降口からはいって行きますと教室はまだしいんとしていましたが、ところどころの窓のすきまから雨がはいって板はまるでざぶざぶしていました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.536,
      "text": "そのうしろから三郎がまるで色のなくなったくちびるをきっと結んでこっちへ出てきました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.646,
      "text": "耕助はまたびっくりしたように木を見上げましたが今度は三郎は木の上にはいませんでした。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.046,
      "text": "それに顔といったらまるで熟したりんごのよう、ことに目はまん丸でまっくろなのでした。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.454,
      "text": "まるで丈ぐらいある草をわけて高みになったり低くなったり、どこまでも走りました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.44,
      "text": "と言いながら一生けん命走って行って、やっとそこへ着いてまるでころぶようにしながら手をひろげたときは、そのときはもう二匹は柵の外へ出ていたのです。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.463,
      "text": "草の中には、今馬と三郎が通った跡らしく、かすかな道のようなものがありました。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.787,
      "text": "見ると一人の変に鼻のとがった、洋服を着てわらじをはいた人が、手にはステッキみたいなものをもって、みんなの魚をぐちゃぐちゃかきまわしているのでした。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.911,
      "text": "と思うと、まるで山つなみのような音がして、一ぺんに夕立がやって来ました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.809,
      "text": "鼻のとがった人はすぱすぱと、煙草を吸うときのような口つきで言いました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.032,
      "text": "一郎はまるでおとなのようにゆっくり大またにやってきて、みんなを見て、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.147,
      "text": "と言いましたので、みんなは火の消えたように一ぺんに手をおろしました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.522,
      "text": "空が旗のようにぱたぱた光って飜り、火花がパチパチパチッと燃えました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.761,
      "text": "まもなく耕助は小指ぐらいの茶いろなかじかが横向きになって流れて来たのをつかみましたし、そのうしろでは嘉助が、まるで瓜をすするときのような声を出しました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.014,
      "text": "というわけは、そのしんとした朝の教室のなかにどこから来たのか、まるで顔も知らないおかしな赤い髪の子供がひとり、いちばん前の机にちゃんとすわっていたのです。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.163,
      "text": "さあみんなはだんだんしいんとなって、まるで堅くなってしまいました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.258,
      "text": "そのとき先生がいつものように呼び子をもって玄関を出て来たのです。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.427,
      "text": "するとにわかに七匹ともまるでたてがみをそろえてかけ出したのです。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.063,
      "text": "五郎はまるで顔じゅう涙だらけにして耕助に組み付こうとしました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.287,
      "text": "三郎はちょっとまごついたようでしたが覚悟したように、「うん。」"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.687,
      "text": "すると三郎はこんどこそはまるで飛び上がって笑ってしまいました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.743,
      "text": "すると一郎は木の上でまるで声をひくくしてみんなに叫びました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.833,
      "text": "その日も十時ごろからやっぱりきのうのように暑くなりました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.728,
      "text": "と一郎は言いましたが、なんだかきまりが悪くなったように、"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.667,
      "text": "三郎は先生みたいな顔つきをして指を一本だしました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.704,
      "text": "ところがきょうも二時間目ころからだんだん晴れてまもなく空はまっ青になり、日はかんかん照って、お午になって一、二年が下がってしまうとまるで夏のように暑くなってしまいました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.151,
      "text": "嘉助はまるで手をたたいて机の中で踊るようにしましたので、大きなほうの子どもらはどっと笑いましたが、下の子どもらは何かこわいというふうにしいんとして三郎のほうを見ていたのです。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.346,
      "text": "みんなはまるでせかせかと走ってのぼりました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.933,
      "text": "びっくりしてはね起きて見ると、外ではほんとうにひどく風が吹いて、林はまるでほえるよう、あけがた近くの青ぐろいうすあかりが、障子や棚の上のちょうちん箱や、家じゅういっぱいでした。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.279,
      "text": "と言いながら一生けん命とり返そうとしましたが、どうしてももう佐太郎は机にくっついた大きな蟹の化石みたいになっているので、とうとうかよは立ったまま口を大きくまげて泣きだしそうになりました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.466,
      "text": "ところがその跡のようなものは、まだ百歩も行かないうちに、おとこえしや、すてきに背の高いあざみの中で、二つにも三つにも分かれてしまって、どれがどれやらいっこうわからなくなってしまいました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.365,
      "text": "「春日明神さんの帯のようだな。」"
    }
  ],
