  "similes": [
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.021,
      "text": "と高く叫ぶ声がして、それからまるで大きなからすのように、嘉助がかばんをかかえてわらって運動場へかけて来ました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.242,
      "text": "それからぜんたいこの運動場は何間あるかというように、正門から玄関まで大またに歩数を数えながら歩きはじめました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.784,
      "text": "ほんとうに暑くなって、ねむの木もまるで夏のようにぐったり見えましたし、空もまるで底なしの淵のようになりました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.069,
      "text": "みんなもまるでせっかく友だちになった子うまが遠くへやられたよう、せっかく捕った山雀に逃げられたように思いました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.6,
      "text": "たばこの木はもう下のほうの葉をつんであるので、その青い茎が林のようにきれいにならんでいかにもおもしろそうでした。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.755,
      "text": "庄助はまるで落ちついて、立って一あし水にはいるとすぐその持ったものを、さいかちの木の下のところへ投げこみました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.767,
      "text": "そのうしろからはちょうど活動写真のように、一人の網シャツを着た人が、はだか馬に乗ってまっしぐらに走って来ました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.897,
      "text": "みんなが、ばたばた防いでいましたら、だんだん粘土がすべって来て、なんだかすこうし下へずれたようになりました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.926,
      "text": "三郎は気味悪そうに川のほうを見ていましたが、色のあせたくちびるを、いつものようにきっとかんで、「なんだい。」"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.962,
      "text": "それから金だらいを出して顔をぶるぶる洗うと、戸棚から冷たいごはんと味噌をだして、まるで夢中でざくざく食べました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.06,
      "text": "みんなそっちへ振り向きますと、五郎が耕助に足のゆびをふまれて、まるでおこって耕助をなぐりつけていたのです。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.838,
      "text": "みんなは町の祭りのときのガスのようなにおいの、むっとするねむの河原を急いで抜けて、いつものさいかち淵に着きました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.942,
      "text": "家の前の栗の木の列は変に青く白く見えて、それがまるで風と雨とで今洗濯をするとでもいうように激しくもまれていました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.424,
      "text": "やはり下へ首をたれて草をかいだり、首をのばしてそこらのけしきをもっとよく見るというようにしているのです。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.245,
      "text": "そのうち三郎は向こうの玄関の前まで行ってしまうと、こっちへ向いてしばらく暗算をするように少し首をまげて立っていました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.358,
      "text": "みんながまたあるきはじめたときわき水は何かを知らせるようにぐうっと鳴り、そこらの木もなんだかざあっと鳴ったようでした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.491,
      "text": "すすきがざわざわざわっと鳴り、向こうのほうは底知れずの谷のように、霧の中に消えているではありませんか。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.116,
      "text": "まもなくみんなははきものを下駄箱に入れて教室へはいって、ちょうど外へならんだときのように組ごとに一列に机にすわりました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.192,
      "text": "「上の野原の入り口にモリブデンという鉱石ができるので、それをだんだん掘るようにするためだそうです。」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.575,
      "text": "その太陽は、少し西のほうに寄ってかかり、幾片かの蝋のような霧が、逃げおくれてしかたなしに光りました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.757,
      "text": "するとまもなく、ぼおというようなひどい音がして水はむくっと盛りあがり、それからしばらくそこらあたりがきいんと鳴りました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.997,
      "text": "二人はしばらくだまったまま、相手がほんとうにどう思っているか探るように顔を見合わせたまま立ちました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.248,
      "text": "三郎は少し困ったように両手をうしろへ組むと向こう側の土手のほうへ職員室の前を通って歩きだしました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.642,
      "text": "もう耕助はじぶんでも持てないくらいあちこちへためていて、口も紫いろになってまるで大きく見えました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.667,
      "text": "耕助は試験のようだし、つまらないことになったと思ってたいへんくやしかったのですが、しかたなくしばらく考えてから言いました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.734,
      "text": "みんなはわれ勝ちに岸からまっさかさまに水にとび込んで、青白いらっこのような形をして底へもぐって、その石をとろうとしました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.706,
      "text": "ひるすぎは先生もたびたび教壇で汗をふき、四年生の習字も五年生六年生の図画もまるでむし暑くて、書きながらうとうとするのでした。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.947,
      "text": "遠くのほうの林はまるで海が荒れているように、ごとんごとんと鳴ったりざっと聞こえたりするのでした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.241,
      "text": "三郎はちょっと具合が悪いようにそこにつっ立っていましたが、また運動場をもう一度見まわしました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.275,
      "text": "と言いながら鉛筆をふところの中へ入れて、あとはシナ人がおじぎするときのように両手を袖へ入れて、机へぴったり胸をくっつけました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.448,
      "text": "嘉助と三郎がもう一匹を押えようとそばへ寄りますと、馬はまるでおどろいたようにどてへ沿って一目散に南のほうへ走ってしまいました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.483,
      "text": "黒板から降る白墨の粉のような、暗い冷たい霧の粒が、そこら一面踊りまわり、あたりがにわかにシインとして、陰気に陰気になりました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.578,
      "text": "はるかな西の碧い野原は、今泣きやんだようにまぶしく笑い、向こうの栗の木は青い後光を放ちました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.722,
      "text": "すると向こう岸についた一郎が、髪をあざらしのようにしてくちびるを紫にしてわくわくふるえながら、"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.066,
      "text": "と一郎が言いながらまた教室のほうを見ましたら、一郎はにわかにまるでぽかんとしてしまいました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.84,
      "text": "すっかり夏のような立派な雲の峰が東でむくむく盛りあがり、さいかちの木は青く光って見えました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.224,
      "text": "それは突然三郎がその下手のみちから灰いろの鞄を右手にかかえて走るようにして出て来たのです。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.829,
      "text": "それは魚の毒もみにつかう山椒の粉で、それを使うと発破と同じように巡査に押えられるのでした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.402,
      "text": "馬はみんないままでさびしくってしようなかったというように一郎たちのほうへ寄ってきました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.656,
      "text": "耕助は何かもっと別のことを言おうと思いましたが、あんまりおこってしまって考え出すことができませんでしたのでまた同じように叫びました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.921,
      "text": "三郎はまるであわてて、何かに足をひっぱられるようにして淵からとびあがって、一目散にみんなのところに走って来て、がたがたふるえながら、"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.292,
      "text": "そしてまるでなんと言ったらいいかわからない、変な気持ちがして歯をきりきり言わせました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.471,
      "text": "けれどもそれも、時々切れたり、馬の歩かないような急な所を横ざまに過ぎたりするのでした。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.975,
      "text": "昇降口からはいって行きますと教室はまだしいんとしていましたが、ところどころの窓のすきまから雨がはいって板はまるでざぶざぶしていました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.444,
      "text": "四人は走って行って急いで丸太をくぐって外へ出ますと、二匹の馬はもう走るでもなく、どての外に立って草を口で引っぱって抜くようにしています。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.536,
      "text": "そのうしろから三郎がまるで色のなくなったくちびるをきっと結んでこっちへ出てきました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.646,
      "text": "耕助はまたびっくりしたように木を見上げましたが今度は三郎は木の上にはいませんでした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.826,
      "text": "すると佐太郎は袖でそれをかくすようにして、急いで学校の裏の岩穴のところへ行きました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.979,
      "text": "するともうだれか来たのかというように奥から先生が出てきましたが、ふしぎなことは先生があたりまえの単衣をきて赤いうちわをもっているのです。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.046,
      "text": "それに顔といったらまるで熟したりんごのよう、ことに目はまん丸でまっくろなのでした。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.188,
      "text": "運動場を出るときその子はこっちをふりむいて、じっと学校やみんなのほうをにらむようにすると、またすたすた白服の大人について歩いて行きました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.391,
      "text": "空にはうすい雲がすっかりかかり、太陽は白い鏡のようになって、雲と反対に馳せました。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.454,
      "text": "まるで丈ぐらいある草をわけて高みになったり低くなったり、どこまでも走りました。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.44,
      "text": "と言いながら一生けん命走って行って、やっとそこへ着いてまるでころぶようにしながら手をひろげたときは、そのときはもう二匹は柵の外へ出ていたのです。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.463,
      "text": "草の中には、今馬と三郎が通った跡らしく、かすかな道のようなものがありました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.506,
      "text": "知らない草穂が静かにゆらぎ、少し強い風が来る時は、どこかで何かが合図をしてでもいるように、一面の草が、それ来たっとみなからだを伏せて避けました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.782,
      "text": "みんなはとった魚を石で囲んで、小さな生け州をこしらえて、生きかえってももう逃げて行かないようにして、また上流のさいかちの木へのぼりはじめました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.205,
      "text": "次の日一郎はあのおかしな子供が、きょうからほんとうに学校へ来て本を読んだりするかどうか早く見たいような気がして、いつもより早く嘉助をさそいました。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.5,
      "text": "けれども、たよりのないことは、みちのはばが五寸ぐらいになったり、また三尺ぐらいに変わったり、おまけになんだかぐるっと回っているように思われました。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.787,
      "text": "見ると一人の変に鼻のとがった、洋服を着てわらじをはいた人が、手にはステッキみたいなものをもって、みんなの魚をぐちゃぐちゃかきまわしているのでした。"
    }
  ],
