  "opening": [
    "検非違使に問われたる木樵りの物語",
    "さようでございます。",
    "あの死骸を見つけたのは、わたしに違いございません。"
  ],
  "closing": [
    "同時におれの口の中には、もう一度血潮が溢れて来る。",
    "おれはそれぎり永久に、中有の闇へ沈んでしまった。",
    "………"
  ],
