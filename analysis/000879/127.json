  "similes": [
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.968,
      "text": "しばらく、死んだように倒れていた老婆が、死骸の中から、その裸の体を起したのは、それから間もなくの事である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.339,
      "text": "羅生門の楼の上へ出る、幅の広い梯子の中段に、一人の男が、猫のように身をちぢめて、息を殺しながら、上の容子を窺っていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.571,
      "text": "それほど、この男の悪を憎む心は、老婆の床に挿した松の木片のように、勢いよく燃え上り出していたのである。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.681,
      "text": "両手をわなわなふるわせて、肩で息を切りながら、眼を、眼球がの外へ出そうになるほど、見開いて、唖のように執拗く黙っている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.391,
      "text": "下人は、守宮のように足音をぬすんで、やっと急な梯子を、一番上の段まで這うようにして上りつめた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.095,
      "text": "ことに門の上の空が、夕焼けであかくなる時には、それが胡麻をまいたようにはっきり見えた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.447,
      "text": "しかも、肩とか胸とかの高くなっている部分に、ぼんやりした火の光をうけて、低くなっている部分の影を一層暗くしながら、永久に唖の如く黙っていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.239,
      "text": "そうして、この門の上へ持って来て、犬のように棄てられてしまうばかりである。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.482,
      "text": "檜皮色の着物を着た、背の低い、痩せた、白髪頭の、猿のような老婆である。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.625,
      "text": "老婆は、一目下人を見ると、まるで弩にでも弾かれたように、飛び上った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.153,
      "text": "前にも書いたように、当時京都の町は一通りならず衰微していた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.749,
      "text": "の赤くなった、肉食鳥のような、鋭い眼で見たのである。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.662,
      "text": "丁度、鶏の脚のような、骨と皮ばかりの腕である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.432,
      "text": "そうして、その死骸は皆、それが、かつて、生きていた人間だと云う事実さえ疑われるほど、土を捏ねて造った人形のように、口を開いたり手を延ばしたりして、ごろごろ床の上にころがっていた。"
    }
  ],
  "reduplications": {
    "ごろごろ": 1
  },
  "opening": [
    "ある日の暮方の事である。",
    "一人の下人が、羅生門の下で雨やみを待っていた。",
    "広い門の下には、この男のほかに誰もいない。"
  ],
  "closing": [
    "そうして、そこから、短い白髪を倒にして、門の下を覗きこんだ。",
    "外には、ただ、黒洞々たる夜があるばかりである。",
    "下人の行方は、誰も知らない。"
  ],
