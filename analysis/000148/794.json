  "similes": [
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.112,
      "text": "野々宮君が何を買っているのかしらと、不審を起こして、店の中へはいってみると、蝉の羽根のようなリボンをぶら下げて、"
    },
    {
      "markers": [
        "似る"
      ],
      "position": 0.386,
      "text": "その字が、野々宮さんのポッケットから半分はみ出していた封筒の上書に似ているので、三四郎は何べんも読み直してみた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.787,
      "text": "――中学教師などの生活状態を聞いてみると、みな気の毒なものばかりのようだが、真に気の毒と思うのは当人だけである。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.918,
      "text": "きょう夢を見るまえまでは、まるで忘れていた、けれどもその当時は頭の中へ焼きつけられたように熱い印象を持っていた。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.217,
      "text": "三四郎は寝台の下から、毛糸のたまを取り出してやろうかと思った、けれども、女が毛糸にはまるで無頓着でいるので控えた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.909,
      "text": "佐々木も昨夜ことごとくあやまってしまったから、きょうあたりはまた晴々して例のごとく飛んで歩いているだろう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.086,
      "text": "たまたまその中にはいってみると、穴倉の下で半年余りも光線の圧力の試験をしている野々宮君のような人もいる。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.202,
      "text": "光線の圧力を試験する人の性癖が、こういう場合にも、同じ態度で表われてくるのだとはまるで気がつかなかった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.575,
      "text": "三四郎は内心感心したようなものの、話がそれてとんだところへ曲がって、曲がりなりに太くなってゆくので、少し驚いていた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.578,
      "text": "これに反して与次郎のごときは露悪党の領袖だけに、たびたびぼくに迷惑をかけて、始末におえぬいたずら者だが、悪気がない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.186,
      "text": "野々宮君のような新式の学者が、もの好きにこんな家を借りて、封建時代の孟宗藪を見て暮らすのと同格である。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.189,
      "text": "座敷の微震がやむまでは茫然としていた三四郎は、石火のごとく、さっきの嘆声と今の列車の響きとを、一種の因果で結びつけた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.611,
      "text": "三四郎が「ぐあいでもよくないのか」と尋ねると、与次郎は鹿のような目を二度ほどぱちつかせて、こう答えた。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.719,
      "text": "おこらせようと思って装置をすると、笑ったり、笑わせようともくろんでかかると、おこったり、まるで反対だ。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.793,
      "text": "ただ句切りが悪くって、字づかいが異様で、言葉の運び方が重苦しくって、まるで古いお寺を見るような心持ちがしただけである。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.938,
      "text": "幕になる少しまえに、隣の男が、そのまた隣の男に、登場人物の声が、六畳敷で、親子差向かいの談話のようだ。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.383,
      "text": "ちょっと聞くとまるでがんぜない子供の言いそうな事であるが、よし子の意味はもう少し深いところにあった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.259,
      "text": "「君なぞは自分のすわっている周囲方二尺ぐらいの所をぼんやり照らすだけだから、丸行燈のようなものだ」"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.368,
      "text": "一言でも先方の意を迎えるような事をいえば、急に卑しくなる、唖の奴隷のごとく、さきのいうがままにふるまっていれば愉快である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.368,
      "text": "三四郎は子供のようなよし子から子供扱いにされながら、少しもわが自尊心を傷つけたとは感じえなかった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.86,
      "text": "その背景が大したもので、東京にいる有為の青年画家をことごとく引き上げて、ことごとく応分の技倆を振るわしたようなことになる。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.24,
      "text": "ある日の午後三四郎は例のごとくぶらついて、団子坂の上から、左へ折れて千駄木林町の広い通りへ出た。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.322,
      "text": "空はかぎりなく晴れて、どこまでも青く澄んでいる上を、綿の光ったような濃い雲がしきりに飛んで行く。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.526,
      "text": "その代り、いかな珍しいものに出会っても、やはり待ち受けていたような目つきで迎えるかと想像される。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.558,
      "text": "縁日へひやかしになど行くと、急に思い出したように、先生松を一鉢お買いなさいなんて妙なことを言う。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.105,
      "text": "青い空の静まり返った、上皮に白い薄雲が刷毛先でかき払ったあとのように、筋かいに長く浮いている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.415,
      "text": "人の家の路地のような所を十間ほど行き尽して、門の手前から板橋をこちら側へ渡り返して、しばらく川の縁を上ると、もう人は通らない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.416,
      "text": "あの人形を見ている連中のうちにはずいぶん下等なのがいたようだから――なにか失礼でもしましたか」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.528,
      "text": "たいへん熱心に見ていたじゃありませんか」と当てたような当てないようなことを大きな声で言った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.888,
      "text": "すると、女房がそれじゃお前さん眠り薬でもかがされたんだろうと言ったら、角三が、うんそういえばなんだかかいだようだと答えたそうだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.931,
      "text": "入場券は象牙と鉛と二通りあって、いずれも賞牌みたような恰好で、表に模様が打ち出してあったり、彫刻が施してあるということも聞いた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.286,
      "text": "三四郎はいつか撮ってやろうと思いながら、次へ移ると、案のごとく三輪田のお光さんが出てきた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.601,
      "text": "蕎麦屋の担夫が午砲が鳴ると、蒸籠や種ものを山のように肩へ載せて、急いで校門をはいってくる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.678,
      "text": "美禰子は、驚いたように、わざと大きな目をして、しかもいちだんと調子を落とした小声になって、"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.901,
      "text": "けれども終局へゆくと、なんのために要領を得てきたのだか、まるでめちゃくちゃになってしまう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.717,
      "text": "文学のほうでいうと、イブセンのようなものじゃないか」と筋向こうの博士が比較を持ち出した。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.558,
      "text": "気が移るので――たとえば田の中を流れている小川のようなものと思っていれば間違いはない。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.006,
      "text": "はじめのうちは音信もあり、月々のものもちゃんちゃんと送ってきたからよかったが、この半年ばかり前から手紙も金もまるで来なくなってしまった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.089,
      "text": "しかししばらくすると、その心持ちのうちに薄雲のような寂しさがいちめんに広がってきた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.36,
      "text": "「ぼくの所の二階へ置いてやってもいいが、なにしろ佐々木のような者がいるから」と言う。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.48,
      "text": "おもしろいことはおもしろいが、――なんだか腹のたしにならないビールを飲んだようだね」"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.663,
      "text": "それから家庭にいて、普通の女性以上の自由を有して、万事意のごとくふるまうに違いない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.843,
      "text": "三四郎はどうともして、二人のあいだにかかった薄い幕のようなものを裂き破りたくなった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.997,
      "text": "これじゃ鼓の音のようにぽんぽんする絵はかけないと自白するはずだ」と広田先生が評した。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.433,
      "text": "三四郎は美禰子の態度をもとのような、――二人の頭の上に広がっている、澄むとも濁るとも片づかない空のような、――意味のあるものにしたかった。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.497,
      "text": "まるで知らないのに、突然来て、君淀見軒へ行こうって、とうとう引っ張っていって……」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.621,
      "text": "このばかみたような挨拶が上下で一句交換されると、三四郎は部屋の中へ首を引っ込める。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.737,
      "text": "これくらい愚な事はない」とまるで自分から事が起こったとは認めていない申し分である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.758,
      "text": "兄との応待をそばにいて聞いていると、広い日あたりのいい畑へ出たような心持ちがする。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.909,
      "text": "三四郎がいつまでたっても、恐れ入ったように控えているので、先生はまた話しはじめた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.054,
      "text": "ただ「するとこれから大学へはいるのですね」といかにも平凡であるかのごとく聞いた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.323,
      "text": "あるいは吹き散らされながら、塊まって、白く柔かな針を集めたように、ささくれだつ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.343,
      "text": "少しのあいだは静かであったが、思い出したように与次郎がまた広田先生に話しかけた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.364,
      "text": "その影が折戸の外へ隠れると、美禰子は急に思い出したように「そうそう」と言いながら、庭先に脱いであった下駄をはいて、野々宮のあとを追いかけた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.11,
      "text": "そのうちの二、三軒には人が黒山のようにたかっている、そうして雑誌を読んでいる。"
    },
    {
      "markers": [
        "似る"
      ],
      "position": 0.211,
      "text": "自分の頭の中に往来する女の顔は、どうも野々宮宗八さんに似ていないのだから困る。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.804,
      "text": "「うん、なかなか」とひとりごとのように、髪の毛と、背景の境の所を塗りはじめた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.834,
      "text": "といって、ラファエルの聖母のようなのは、てんでありゃしないし、あったところが日本人とは言われないから、そこで里見さんを煩わすことになったのさ。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.845,
      "text": "すると、女はすこしも刺激に感じない、しかも、いつものごとく男を酔わせる調子で、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.19,
      "text": "窓から外をのぞくと、一面の星月夜で、土手下の汽車道は死んだように静かである。"
    }
  ],
