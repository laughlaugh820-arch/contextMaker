  "similes": [
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.414,
      "text": "敵の大将は、弓の真中を右の手で握って、その弓を草の上へ突いて、酒甕を伏せたようなものの上に腰をかけていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.326,
      "text": "爺さんは茶碗のような大きなもので酒をぐいと飲んで、そうして、ふうと長い息を白い髯の間から吹き出した。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.528,
      "text": "運慶は頭に小さい烏帽子のようなものを乗せて、素袍だか何だかわからない大きな袖を背中で括っている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.425,
      "text": "その端の所は藁を少し編残して、房のように下げて、歩くとばらばら動くようにして、飾りとしていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.334,
      "text": "すると爺さんが、また茶碗のような大きなもので熱い酒をぐいと飲んで前のような息をふうと吹いて、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.113,
      "text": "片膝を座蒲団の上に突いて、灯心を掻き立てたとき、花のような丁子がぱたりと朱塗の台に落ちた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.302,
      "text": "おれは人殺であったんだなと始めて気がついた途端に、背中の子が急に石地蔵のように重くなった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.158,
      "text": "自分はこの鋭い刃が、無念にも針の頭のように縮められて、九寸五分の先へ来てやむをえず尖ってるのを見て、たちまちぐさりとやりたくなった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.434,
      "text": "大将は草の上に突いていた弓を向うへ抛げて、腰に釣るした棒のような剣をするりと抜きかけた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.99,
      "text": "けれども、とうとう精根が尽きて、手が蒟蒻のように弱って、しまいに豚に舐められてしまった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.279,
      "text": "ただ背中に小さい小僧がくっついていて、その小僧が自分の過去、現在、未来をことごとく照して、寸分の事実も洩らさない鏡のように光っている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.054,
      "text": "静かな水が動いて写る影を乱したように、流れ出したと思ったら、女の眼がぱちりと閉じた。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.568,
      "text": "まるで土の中から石を掘り出すようなものだからけっして間違うはずはない」と云った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.305,
      "text": "広い土間の真中に涼み台のようなものを据えて、その周囲に小さい床几が並べてある。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.438,
      "text": "自分は右の手を楓のように開いて、掌を大将の方へ向けて、眼の上へ差し上げた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.602,
      "text": "そうして、しまいには焼火箸のようにじゅっといってまた波の底に沈んで行く。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.129,
      "text": "あれば安心だから、蒲団をもとのごとく直して、その上にどっかり坐った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.706,
      "text": "喇叭を口へあてがっているんで、頬ぺたが蜂に螫されたように膨れていた。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.657,
      "text": "けれども二人は二人以外の事にはまるで頓着していない様子であった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.838,
      "text": "八の字が、鳩が二羽向いあったような書体にできているのが面白い。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.532,
      "text": "わいわい云ってる見物人とはまるで釣り合が取れないようである。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.195,
      "text": "その切ないものが身体中の筋肉を下から持上げて、毛穴から外へ吹き出よう吹き出ようと焦るけれども、どこも一面に塞がって、まるで出口がないような残刻極まる状態であった。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.395,
      "text": "そうして髯も顔も頭も頭巾もまるで見えなくなってしまった。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.215,
      "text": "声は子供の声に相違ないが、言葉つきはまるで大人である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.409,
      "text": "革の帯を締めて、それへ棒のような剣を釣るしていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.454,
      "text": "崩れるたびに狼狽えたように焔が大将になだれかかる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.47,
      "text": "鼻から火の柱のような息を二本出して飛んで来る。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.475,
      "text": "女の髪は吹流しのように闇の中に尾を曳いた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.638,
      "text": "しかし身体には更紗のような洋服を着ていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.597,
      "text": "ただ波の底から焼火箸のような太陽が出る。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.742,
      "text": "自転車と人力車はまるで見えなくなった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.245,
      "text": "赤い字は井守の腹のような色であった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.351,
      "text": "それを肝心綯のように細長く綯った。"
    }
  ],
