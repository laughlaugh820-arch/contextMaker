  "similes": [
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.144,
      "text": "手紙をかいてしまったら、いい心持ちになって眠気がさしたから、最前のように座敷の真中へのびのびと大の字に寝た。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.339,
      "text": "船縁から覗いてみたら、金魚のような縞のある魚が糸にくっついて、右左へ漾いながら、手に応じて浮き上がってくる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.557,
      "text": "その上今時のお嬢さんのように読み書きが達者でないものだから、こんなまずい字でも、かくのによっぽど骨が折れる。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.18,
      "text": "教場のしくじりが生徒にどんな影響を与えて、その影響が校長や教頭にどんな反応を呈するかまるで無頓着であった。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.366,
      "text": "「君が来たんで生徒も大いに喜んでいるから、奮発してやってくれたまえ」と今度は釣にはまるで縁故もない事を云い出した。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.408,
      "text": "おれは、控所へはいるや否や返そうと思って、うちを出る時から、湯銭のように手の平へ入れて一銭五厘、学校まで握って来た。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.45,
      "text": "校長はもうやがて見えるでしょうと、自分の前にある紫の袱紗包をほどいて、蒟蒻版のような者を読んでいる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.342,
      "text": "一番槍はお手柄だがゴルキじゃ、と野だがまた生意気を云うと、ゴルキと云うと露西亜の文学者みたような名だねと赤シャツが洒落た。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.364,
      "text": "聞いたって……と野だが振り返った時、おれは皿のような眼を野だの頭の上へまともに浴びせ掛けてやった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.201,
      "text": "小供の時から、こんなに教育されるから、いやにひねっこびた、植木鉢の楓みたような小人が出来るんだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.2,
      "text": "一時間あるくと見物する町もないような狭い都に住んで、外に何にも芸がないから、天麩羅事件を日露戦争のように触れちらかすんだろう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.352,
      "text": "野だのようなのは、馬車に乗ろうが、船に乗ろうが、凌雲閣へのろうが、到底寄り付けたものじゃない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.551,
      "text": "おれのような単純なものには白とか黒とか片づけてもらわないと、どっちへ味方をしていいか分らない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.362,
      "text": "線香の烟のような雲が、透き徹る底の上を静かに伸して行ったと思ったら、いつしか底の奥に流れ込んで、うすくもやを掛けたようになった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.526,
      "text": "爺さんが夜るになると、変な声を出して謡をうたうには閉口するが、いか銀のようにお茶を入れましょうと無暗に出て来ないから大きに楽だ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.69,
      "text": "下宿の婆さんもけちん坊の欲張り屋に相違ないが、嘘は吐かない女だ、赤シャツのように裏表はない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.698,
      "text": "途中で親切な女みたような男だと思い返した事はあるが、それが親切でも何でもなさそうなので、反動の結果今じゃよっぽど厭になっている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.895,
      "text": "不思議な事に今まで身体の関節が非常に痛かったのが、飛び起きると同時に忘れたように軽くなった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.813,
      "text": "つまりは向うから手を出しておいて、世間体はこっちが仕掛けた喧嘩のように、見傚されてしまう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.582,
      "text": "山嵐のようにおれが居なくっちゃ日本が困るだろうと云うような面を肩の上へ載せてる奴もいる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.582,
      "text": "そうかと思うと、赤シャツのようにコスメチックと色男の問屋をもって自ら任じているのもある。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.863,
      "text": "歌はすこぶる悠長なもので、夏分の水飴のように、だらしがないが、句切りをとるためにぼこぼんを入れるから、のべつのようでも拍子は取れる。"
    },
    {
      "markers": [
        "似る"
      ],
      "position": 0.15,
      "text": "中学校に居た時ウィッチと云う言葉を習った事があるがこの女房はまさにウィッチに似ている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.321,
      "text": "「あの松を見たまえ、幹が真直で、上が傘のように開いてターナーの画にありそうだね」と赤シャツが野だに云うと、野だは「全くターナーですね。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.424,
      "text": "「そんなに一銭五厘が気になるなら取ってもいいが、なぜ思い出したように、今時分返すんだ」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.501,
      "text": "だんまりで辞令を下げておいて、蕎麦を食うな、団子を食うなと罪なお布令を出すのは、おれのような外に道楽のないものにとっては大変な打撃だ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.017,
      "text": "母が大層怒って、お前のようなものの顔は見たくないと云うから、親類へ泊りに行っていた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.438,
      "text": "この場合のような、誰が見たって、不都合としか思われない事件に会議をするのは暇潰しだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.344,
      "text": "おれのような数学の教師にゴルキだか車力だか見当がつくものか、少しは遠慮するがいい。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.583,
      "text": "皆々それ相応に威張ってるんだが、このうらなり先生のように在れどもなきがごとく、人質に取られた人形のように大人しくしているのは見た事がない。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.801,
      "text": "命令も下さないのに勝手な軍歌をうたったり、軍歌をやめるとワーと訳もないのに鬨の声を揚げたり、まるで浪人が町内をねりあるいてるようなものだ。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.94,
      "text": "堀田も去りあなたも去ったら、学校の数学の授業がまるで出来なくなってしまうから……」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.805,
      "text": "よく考えてみると世の中はみんなこの生徒のようなものから成立しているかも知れない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.224,
      "text": "一体疳性だから夜具蒲団などは自分のものへ楽に寝ないと寝たような心持ちがしない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.489,
      "text": "おれの云おうと思うところをおれの代りに山嵐がすっかり言ってくれたようなものだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.626,
      "text": "赤シャツのようなやさしいのと、親切なのと、高尚なのと、琥珀のパイプとを自慢そうに見せびらかすのは油断が出来ない、めったに喧嘩も出来ないと思った。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.913,
      "text": "ことに自分の弟が山嵐を誘い出したのを自分の過失であるかのごとく吹聴していた。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.49,
      "text": "おれはこう云う単純な人間だから、今までの喧嘩はまるで忘れて、大いに難有いと云う顔をもって、腰を卸した山嵐の方を見たら、山嵐は一向知らん面をしている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.581,
      "text": "世の中には野だみたように生意気な、出ないで済む所へ必ず顔を出す奴もいる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.627,
      "text": "喧嘩をしても、回向院の相撲のような心持ちのいい喧嘩は出来ないと思った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.68,
      "text": "ちょっと話せばいいんです、と云って、赤シャツの顔を見ると金時のようだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.987,
      "text": "「貴様のような奸物はなぐらなくっちゃ、答えないんだ」とぽかぽかなぐる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.393,
      "text": "弱虫は親切なものだから、あの赤シャツも女のような親切ものなんだろう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.976,
      "text": "町を外れると急に馳け足の姿勢で、はやてのように後ろから、追いついた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.588,
      "text": "何だか水晶の珠を香水で暖ためて、掌へ握ってみたような心持ちがした。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.343,
      "text": "そうですね、まるで露西亜の文学者ですねと野だはすぐ賛成しやがる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.615,
      "text": "川の流れは浅いけれども早いから、神経質の水のようにやたらに光る。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.119,
      "text": "おれがはいったのを見て、みんな申し合せたようにおれの顔を見た。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.642,
      "text": "そこで君が今のように出精して下されば、学校の方でも、ちゃんと見ているんだから、もう少しして都合さえつけば、待遇の事も多少はどうにかなるだろうと思うんですがね」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.818,
      "text": "中学と師範とはどこの県下でも犬と猿のように仲がわるいそうだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.108,
      "text": "校長は薄髯のある、色の黒い、目の大きな狸のような男である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.319,
      "text": "高柏寺の五重の塔が森の上へ抜け出して針のように尖がってる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.025,
      "text": "おれは到底人に好かれる性でないとあきらめていたから、他人から木の端のように取り扱われるのは何とも思わない、かえってこの清のようにちやほやしてくれるのを不審に考えた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.5,
      "text": "おれは脳がわるいから、狸の云うことなんか、よく分らないが、蕎麦屋や団子屋へ行って、中学の教師が勤まらなくっちゃ、おれみたような食い心棒にゃ到底出来っ子ないと思った。"
    },
    {
      "markers": [
        "似る"
      ],
      "position": 0.516,
      "text": "切り下げの品格のある婦人だが、よくうらなり君に似ている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.782,
      "text": "すると、いつの間にか傍へ来て坐った、野だが、鈴ちゃん逢いたい人に逢ったと思ったら、すぐお帰りで、お気の毒さまみたようでげすと相変らず噺し家みたような言葉使いをする。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.053,
      "text": "この方は大分金になったようだが、詳しい事は一向知らぬ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.856,
      "text": "次はぽんと音がして、黒い団子が、しょっと秋の空を射抜くように揚がると、それがおれの頭の上で、ぽかりと割れて、青い烟が傘の骨のように開いて、だらだらと空中に流れ込んだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.02,
      "text": "元来女のような性分で、ずるいから、仲がよくなかった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.598,
      "text": "うらなり君は活版で押したように下等ばかりへ乗る男だ。"
    }
  ],
