  "similes": [
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.391,
      "text": "白木綿の着物に同じ丸絎の帯をしめて、上から蚊帳のように粗い法衣を羽織って、すこぶる気楽に見える小坊主であった。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.754,
      "text": "ようやく登り詰めて、余の双眼が今危巌の頂きに達したるとき、余は蛇に睨まれた蟇のごとく、はたりと画筆を取り落した。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.98,
      "text": "文明は個人に自由を与えて虎のごとく猛からしめたる後、これを檻穽の内に投げ込んで、天下の平和を維持しつつある。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.452,
      "text": "楽は聴くべきもの、習うべきものであると、始めて気がついたが、不幸にして、その辺の消息はまるで不案内である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.885,
      "text": "染み込んだ春の日が、深く草の根に籠って、どっかと尻を卸すと、眼に入らぬ陽炎を踏み潰したような心持ちがする。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.162,
      "text": "余はとうとう夜の明けるまで一睡もせずに、怪し気な蚊帳のうちに辛防しながら、まるで草双紙にでもありそうな事だと考えた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.41,
      "text": "掌に顎を支えたる余の心も、わが住む部屋のごとく空しければ、春風は招かぬに、遠慮もなく行き抜けるであろう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.517,
      "text": "松の下に黒くさびた鉄灯籠が名の知れぬ赤石の上に、いつ見ても、わからず屋の頑固爺のようにかたく坐っている。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.769,
      "text": "きびきびしているなと、のっそり山門を這入って、見ると、広い庫裏も本堂も、がらんとして、人影はまるでない。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.893,
      "text": "あくる日、眼が覚めるや否や、飛び起きて、机の前へ行って見ると、花は萎え葉は枯れて、白い穂だけが元のごとく光っている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.067,
      "text": "しかし普通の小説家のようにその勝手な真似の根本を探ぐって、心理作用に立ち入ったり、人事葛藤の詮議立てをしては俗になる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.299,
      "text": "のみならず青磁の皿に盛られた青い煉羊羹は、青磁のなかから今生れたようにつやつやして、思わず手を出して撫でて見たくなる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.34,
      "text": "仰向くと蟇蛙を前から見たように真平に圧し潰され、少しこごむと福禄寿の祈誓児のように頭がせり出してくる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.624,
      "text": "この夢のような詩のような春の里に、啼くは鳥、落つるは花、湧くは温泉のみと思い詰めていたのは間違である。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.018,
      "text": "左右が高くって、中心が窪んで、まるで一間幅を三角に穿って、その頂点が真中を貫いていると評してもよい。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.784,
      "text": "高さは七八尺もあろう、糸瓜ほどな青い黄瓜を、杓子のように圧しひしゃげて、柄の方を下に、上へ上へと継ぎ合せたように見える。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.967,
      "text": "「あの山の向うを、あなたは越していらしった」と女が白い手を舷から外へ出して、夢のような春の山を指す。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.611,
      "text": "形容して見ると紫色の蒸羊羹の奥に、隠元豆を、透いて見えるほどの深さに嵌め込んだようなものである。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.077,
      "text": "まだ十五丁かと、振り向いているうちに、馬子の姿は影画のように雨につつまれて、またふうと消えた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.652,
      "text": "ただあなたとわたしのように、こういっしょにいるところなんで、その場限りで面白味があるでしょう」"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.063,
      "text": "まるで人情を棄てる訳には行くまいが、根が詩的に出来た旅だから、非人情のやりついでに、なるべく節倹してそこまでは漕ぎつけたいものだ。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.412,
      "text": "握る名と奪える誉とは、小賢かしき蜂が甘く醸すと見せて、針を棄て去る蜜のごときものであろう。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.56,
      "text": "老人は頭の毛をことごとく抜いて、頬と顎へ移植したように、白い髯をむしゃむしゃと生やして、茶托へ載せた茶碗を丁寧に机の上へならべる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.815,
      "text": "蜀犬日に吠え、呉牛月に喘ぐと云うから、わしのような田舎者は、かえって困るかも知れんてのう」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.859,
      "text": "義理とか人情とか云う、尋常の道具立を背景にして、普通の小説家のような観察点からあの女を研究したら、刺激が強過ぎて、すぐいやになる。"
    },
    {
      "markers": [
        "あたかも"
      ],
      "position": 0.613,
      "text": "しかもその九個が整然と同距離に按排されて、あたかも人造のねりものと見違えらるるに至ってはもとより天下の逸品をもって許さざるを得ない。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.779,
      "text": "仰数春星一二三の句を得て、石磴を登りつくしたる時、朧にひかる春の海が帯のごとくに見えた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.15,
      "text": "何だか廻廊のような所をしきりに引き廻されて、しまいに六畳ほどの小さな座敷へ入れられた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.528,
      "text": "踏む石は天鵞のごとく柔かと見えて、足音を証にこれを律すれば、動かぬと評しても差支ない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.592,
      "text": "床は平床を鏡のようにふき込んで、気を吹いた古銅瓶には、木蘭を二尺の高さに、活けてある。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.676,
      "text": "「その坊主にさっき逢いましたよ」と地震に揺れた池の水のように円満な動き方をして見せる。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.852,
      "text": "余が挨拶をしようと思う途端に、女は、左の手を落としたまま、右の手を風のごとく動かした。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.551,
      "text": "今一歩を踏み出せば、せっかくの嫦娥が、あわれ、俗界に堕落するよと思う刹那に、緑の髪は、波を切る霊亀の尾のごとくに風を起して、莽と靡いた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.662,
      "text": "攫われて空行く人のごとく、ただ不可思議の千万無量――あとがちょっと読みにくいですよ。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.473,
      "text": "ただ無地と模様のつながる中が、おのずから暈されて、夜と昼との境のごとき心地である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.489,
      "text": "しかし夢のように、三尺の幅を、すうと抜ける影を見るや否や、何だか口が聴けなくなる。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.842,
      "text": "朝飯をすまして、一本の敷島をゆたかに吹かしたるときの余の観想は以上のごとくである。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.788,
      "text": "「時に九月天高く露清く、山空しく、月明かに、仰いで星斗を視れば皆光大、たまたま人の上にあるがごとし、窓間の竹数十竿、相摩戞して声切々やまず。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.914,
      "text": "二人の姿勢がかくのごとく美妙な調和を保っていると同時に、両者の顔と、衣服にはあくまで、対照が認められるから、画として見ると一層の興味が深い。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.013,
      "text": "立ち上がる時に向うを見ると、路から左の方にバケツを伏せたような峰が聳えている。"
    },
    {
      "markers": [
        "ごとし",
        "似る"
      ],
      "position": 0.66,
      "text": "――真夜中の甲板に帆綱を枕にして横わりたる、男の記憶には、かの瞬時、熱き一滴の血に似たる瞬時、女の手を確と把りたる瞬時が大濤のごとくに揺れる。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.675,
      "text": "と口のうちで静かに読み了って、また余の方へ向き直ったが、急に思い出したように、"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.757,
      "text": "帯の間に椿の花の如く赤いものが、ちらついたと思ったら、すでに向うへ飛び下りた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.28,
      "text": "膳を引くとき、小女郎が入口の襖を開たら、中庭の栽込みを隔てて、向う二階の欄干に銀杏返しが頬杖を突いて、開化した楊柳観音のように下を見詰めていた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.49,
      "text": "面倒にも気の毒にも、初手から、余のごときものに、気をかねておらぬ有様で通る。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.508,
      "text": "しかし流れて行く人の表情が、まるで平和ではほとんど神話か比喩になってしまう。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.547,
      "text": "しかもこの姿は普通の裸体のごとく露骨に、余が眼の前に突きつけられてはおらぬ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.697,
      "text": "寸燐は短かい草のなかで、しばらく雨竜のような細い煙りを吐いて、すぐ寂滅した。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.009,
      "text": "二十五年にして明暗は表裏のごとく、日のあたる所にはきっと影がさすと悟った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.737,
      "text": "「その嬢様は、やはり今の嬢様のように美しい嬢様であったそうながな、旦那様」"
    },
    {
      "markers": [
        "見紛う"
      ],
      "position": 0.847,
      "text": "英人にもこんな明かな色を出すものがあるかと疑うくらい判然出来上っている。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.911,
      "text": "するりと抜け出たのは、九寸五分かと思いのほか、財布のような包み物である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.927,
      "text": "私なんぞは、今のようなところを人に見られても恥かしくも何とも思いません」"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.837,
      "text": "余のごときは、探偵に屁の数を勘定される間は、とうてい画家にはなれない。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.379,
      "text": "丘のごとくに堆かく、積み上げられた、貝殻は牡蠣か、馬鹿か、馬刀貝か。"
    },
    {
      "markers": [
        "似る"
      ],
      "position": 0.54,
      "text": "年々に見るサロンの目録はこの芸妓に似たる裸体美人を以て充満している。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.562,
      "text": "この僧は六十近い、丸顔の、達磨を草書に崩したような容貌を有している。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.579,
      "text": "あれはまるでいたずらです」と若い男はしきりに、恥かしがって謙遜する。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.69,
      "text": "「天来の奇想のように」、と形容した西人の句はとうていあてはまるまい。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.495,
      "text": "温泉と云う名を聞けば必ずこの句にあらわれたような愉快な気持になる。"
    }
  ],
