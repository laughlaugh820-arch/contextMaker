  "similes": [
    {
      "markers": [
        "みたい"
      ],
      "position": 0.136,
      "text": "トラホームの子供や肺病やみみたいなおかみさんや蒼んぶくれのじいさんなどが、狭い診療室から廊下にまで溢れている。"
    },
    {
      "markers": [
        "あたかも"
      ],
      "position": 0.486,
      "text": "と見た次の瞬間、またもやその鏡のなかから、強い火花が俺の眼をめがけて――あたかも銃口が火を吹いたすごさだった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.004,
      "text": "路地は迷路のようにつづいていて、家と家の間の、ひと一人やっと通れる狭い道には「抜けられます」と書いてあった。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.092,
      "text": "それは同時に、強権に対しては奴隷のごとく従順な民衆の心から、強権に対する畏怖を取りのぞこうということだった。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.372,
      "text": "前掛けをしているとはいえ、足を男みたいに大胆に開いて、ザルを股の間に挾むようにして、それに枝豆を落している。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.388,
      "text": "しかし俺があの梶川悲堂をえらいじいさんだと感心したのは、ちっとも国賓みたいなえらそうな顔をしてないところだ。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.444,
      "text": "特におでこがてらてらに黒光りしていて、そのまわりをキリストのあのイバラのように、もじゃもじゃの髪がかこんでいる。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.492,
      "text": "おお寒いとオカマは背広のえりを、着物みたいにぴったり合わせ、そのえりもとを左手だけでおさえて、右手を浮かせると、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.571,
      "text": "心にわだかまっていることを一気に吐露する、一見そんなふうで実はむしろ内心を隠そうとするためのお喋りのようだった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.599,
      "text": "綾子への詮索に対して金原が俺には無言を通した、そのかわりのように黙って何も言わないで、俺の手紙を受け取った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.608,
      "text": "この北の果てで、道産子のように生きることこそ、平凡のようでむしろこのほうが「どえらい」ことにちがいないのだ。"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.661,
      "text": "「軍の上層部には、まるで彼らのための天皇陛下というような考えとしか思えん、そうとしかわしには思えんのがいる」"
    },
    {
      "markers": [
        "まるで"
      ],
      "position": 0.718,
      "text": "ながい病床生活ですっかり足が萎えてしまった俺は、降り積った雪を踏む足が、まるで雲の中を歩くような頼りなさだった。"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.724,
      "text": "重臣の暗殺は、蹶起の目的ではなく国内改革のための手段だったはずだが、これではまるでその手段が目的だったみたいだ。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.825,
      "text": "骨と皮みたいな老車夫に俺は同情して、いい加減のところで折り合えと言いたかったが、ロクは執拗にまけさせていた。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.849,
      "text": "そしてその急須を両手で包みこむようにしてしばらくじっとしていたのち、鳥の摺り餌入れみたいに小さな茶碗の上に傾け、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.924,
      "text": "惨めな姿を俺に、これ以上もう見せなくてもいいでしょう――しょんぼりした後ろ姿は、そう言っているかのようだったが、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.939,
      "text": "重大なとは、もったい振った言い方のようだけど、丸万がコムミュニストになったというのは、俺には実に重大なのである。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.004,
      "text": "気のせいか、この路地には、トロ（精液）の臭いとそれから消毒液の臭いが、むーんと立ちこめているみたいだった。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.125,
      "text": "それが体温で乾いて、ヨシコのさきを、のりでくっつけたみたいに、エテマタにくっついて離れないようにしていた。"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.244,
      "text": "デパートにリャクに行った帰りだという砂馬は、まるで右翼みたいに、アオチ（羽織）をはおってマハカ（袴）をつけていた。"
    },
    {
      "markers": [
        "ごとし"
      ],
      "position": 0.273,
      "text": "６　Ｓ首相代理以下に辞表を提出せしめ、大命は尾垣大将に降下する如く、あらかじめ準備せるところに従い策動す。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.516,
      "text": "このアビルは俺を見ると、これはまたどうしたことか、彼もまた狼狽したように、ローソクの光を急いで吹き消した。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.619,
      "text": "暗い陰湿の顔に喜色を浮べて矢萩が言ったとき、朝倉がさも気に入らないことを言われたかのように、ぷいと立った。"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.687,
      "text": "あんたがどこかへ消えちまったのを、まるで俺のせいみたいに言やあがって……あんたは、ほんとは本庁の直轄なんだがねえ」"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.744,
      "text": "慷堂の痩躯が蜂の巣のように銃弾を受けた日、彼の愛していた中国に、日本の渡洋爆撃機が空から盲爆を加えていた。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.96,
      "text": "いらいらしていると知らされたのも癪だったが、俺の殺した矢萩のくせが俺にのり移ったみたいなのも不愉快だった。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.0,
      "text": "旧式の機関車がその道路の真中に立ちはだかって、老いぼれの喘息病みみたいに、ゼーゼーと白い息を吐いている。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.231,
      "text": "そういう仕掛けになっているようだが、自由をたっとぶ俺たちのほうでは、そんな官僚組織みたいなことはしない。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.393,
      "text": "その密培地へは行けなかったとさっきは否定した砂馬が、まるで現場で見て来たような阿片の採集法をこんなふうに俺に語った。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.465,
      "text": "いやがらせを言い散らしているみたいだが、俺の気持としてはもっとどぎついいやがらせを自分自身に向けて言いたいのだった。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.506,
      "text": "このみじめな男に俺は哀れみを覚えるかわりに、芋虫みたいなこいつを、この野郎とひねり潰してやりたくなった。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.528,
      "text": "スクリーンの悲劇に満足した人々の黒い影が、明るい灯を背景にした走馬燈のように動いて、俺たちとは別世界のようだったが、"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.719,
      "text": "巡査の姿は見かけないにもかかわらず、巡査にまるで遮られているかのように、人々はおのずと一線を画していた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.868,
      "text": "商売柄、技巧的なものが感じられたが、俺が上海に来たことを誰からも知らされていないことは事実のようだった。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.241,
      "text": "山の手あたりから、こうして客が、名物でも食うみたいな顔をして来ているのは、昔を思うと、おかしなものだ。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.443,
      "text": "乞食としか思えない身なりの男が、それまでは壁にヤモリみたいにへばりついていたのに急に、俺に声をかけた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.515,
      "text": "ロクマ（大道易者）のアビルの、乞食のような姿は、こっちの気のせいもあってか、神秘と威厳にみちたものとして俺に見られた。"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.602,
      "text": "波子の横に寝かされた赤ん坊が、このときまるでその母親の波子を俺がいじめたみたいに急にオフギャーオフギャーと泣き出した。"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.628,
      "text": "まるで照子をオトリに使って俺をおびき出そうとするみたいな、いや、たしかにそうにちがいないそのやり口も気に食わなかった。"
    },
    {
      "markers": [
        "ようだ",
        "みたい",
        "まるで"
      ],
      "position": 0.74,
      "text": "その眼が今は、おだやかに閉じられ、並べたように皮膚にはりついたながい睫毛がまるで細い画筆で描いたみたいな綺麗さだった。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.763,
      "text": "この数年で急に年取ったみたいなロクは、なまっちろい顔が黄色くしなび、くびに年寄りじみたしわが目立った。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.139,
      "text": "馬の注射器みたいな太い管に、紫色の液体をたっぷり入れて、それを俺のヨシコのさきから注入するのである。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.324,
      "text": "手製のチャチな屋台みたいなものを肩から釣って、街を流しているが、あれでどれほどの稼ぎになるのだろう。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.351,
      "text": "波子のほうも、その夫婦偽装は、上京したい一念からで、色恋みたいなものではないと俺には見られたからだ。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.499,
      "text": "寒風に吹きさらされながら、触るとそれは熱いみたいな、いやにいきいきした波子の唇が、くらいつきたいくらい、俺の眼をひいた。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.513,
      "text": "このいわばくだらない狼狽を、俺はさもそれが俺のもとめていた狼狽であるかのように、主観的に大ゲサに受け取ったのであろうか。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.677,
      "text": "小柄な小肥りした身体も、ガリダマ（卵）みたいな、ころころっとした感じなのに、俺もつい微笑を誘われて、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.741,
      "text": "人形のつけ睫毛のように綺麗でながく、可愛いと言えば可愛いが、しかし可愛いと見えることがかえってむごたらしさを感じさせた。"
    },
    {
      "markers": [
        "ようだ",
        "まるで"
      ],
      "position": 0.778,
      "text": "風巻は両手ではさんでいた眼鏡を胸もとまであげて、それがまるで俺の詩であるかのように胸に抱きかかえて、"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.791,
      "text": "ベッドにもぐりこんだまま、食堂にも姿も見せなかった屑鉄屋は、廃墟のような対岸の「戦蹟」に眼を丸めて、"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.812,
      "text": "まるで白日夢みたいだが、車窓の外は阿鼻叫喚――そう形容しても誇張ではない騒ぎがそこに展開されていた。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.818,
      "text": "ウェイウェイと黄包車でも呼ぶみたいな声で、招待を呼んで、砂馬の小皿を新しいのに変えろと、わざとらしい忠勤振りを発揮した。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.938,
      "text": "兵隊に取られた人たちは、みんな大概、人殺しをやってるんだが、俺みたいにその人殺しで気が狂ったという話はあんまり聞かない。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.941,
      "text": "今の現実は昔のようなすさまじいそれではないが――いや、もうすこしすると、俺も異常な運命に見舞われる。"
    },
    {
      "markers": [
        "みたい"
      ],
      "position": 0.985,
      "text": "いや、実際、そいつは人語を解するみたいに、やにわにその爪先で地を掻くようにして、ひょいと立ち上った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.003,
      "text": "路地の真中を、ほかの用で歩いているかのような足どりで行くのは、こういう場所にまだなれない男である。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.13,
      "text": "俺は玉塚もリン病になったのだなと思い、俺もこの詩のように「ウミだらけの社会を血で洗おう」と思った。"
    },
    {
      "markers": [
        "ようだ"
      ],
      "position": 0.157,
      "text": "眼光烱々と言うと、いかにも古風な形容だが、それがまたぴたりと当てはまる、古武士のような慷堂である。"
    },
    {
      "markers": [
        "みたい",
        "まるで"
      ],
      "position": 0.168,
      "text": "ところが、この時の俺にはまるで、神聖な仕事場が俺の出現でけがされたのを、おやじは怒って、塩で浄めようとしたみたいに見えた。"
    }
